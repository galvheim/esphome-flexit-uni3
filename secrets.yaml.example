# Legg disse inn i ESPHome sin secrets.yaml (Device Builder → «Secrets»).
# Ikke legg secrets.yaml på GitHub.

wifi_ssid: "MittNettverk"
wifi_password: "MittWiFiPassord"

# Nøkkel for API og OTA. Lag en ny med: openssl rand -base64 32
# (eller kopier den Device Builder lager når du oppretter enheten)
flexit_api_key: "BYTT-MEG-32-byte-base64-nokkel="
